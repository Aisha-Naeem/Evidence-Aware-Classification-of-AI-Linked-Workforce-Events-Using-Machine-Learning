        "jf_writing_editorial_and_translation"
      ]
    },
    "exp3_combined": {
      "use_text": true,
      "use_context": true,
      "columns": [
        "text_clean",
        "claim_word_count",
        "claim_number_count",
        "claim_quote_count",
        "ai_term_count",
        "business_reason_count",
        "third_party_count",
        "ai_negation_count",
        "source_is_company",
        "source_is_filing",
        "sector_group",
        "region",
        "country_primary",
        "kind",
        "execution",
        "log_headcount",
        "pct_workforce",
        "year",
        "month_sin",
        "month_cos",
        "n_job_families",
        "multi_country",
        "is_us",
        "has_headcount",
        "has_pct_workforce",
